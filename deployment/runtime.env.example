# ==============================================================================
# EnvScale — Host Runtime Configuration & Secrets Contract (TEMPLATE ONLY)
# ==============================================================================
# SECURITY NOTICE:
#   - NEVER place real secret values in Git or Terraform variables/state.
#   - On production EC2 hosts, secrets are retrieved at deploy/bootstrap time
#     from AWS SSM Parameter Store (/envscale/prod/* SecureString via alias/aws/ssm)
#     into /etc/envscale/secrets.env with mode 0600 (root:root).
#   - Image references (API_SERVER_IMAGE, STREAMER_IMAGE, WEB_IMAGE) are NOT
#     configured here; they come exclusively from a validated release manifest
#     (deployment/release/release-schema.json) with @sha256:... digests.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL 16 Credentials (SSM: /envscale/prod/postgres_password)
#    DATABASE_URL is derived automatically with RFC-3986 URL-encoding by
#    host-runtime.sh unless explicitly overridden.
#    NOTE: Changing POSTGRES_PASSWORD after volume initialization requires an
#    explicit `ALTER ROLE envscale WITH PASSWORD ...` inside PostgreSQL first.
# ------------------------------------------------------------------------------
POSTGRES_USER=envscale
POSTGRES_DB=envscale
POSTGRES_PASSWORD=__SET_VIA_SSM_SECURESTRING_MIN_24_CHARS__

# ------------------------------------------------------------------------------
# 2. Redis 7 Cache & Pub/Sub Credentials (SSM: /envscale/prod/redis_password)
#    REDIS_URL is derived automatically with RFC-3986 URL-encoding by
#    host-runtime.sh unless explicitly overridden.
# ------------------------------------------------------------------------------
REDIS_PASSWORD=__SET_VIA_SSM_SECURESTRING_MIN_24_CHARS__

# ------------------------------------------------------------------------------
# 3. Authentication & Token Signing Secrets (Minimum 32 random bytes)
#    - JWT_ACCESS_SECRET  : SSM /envscale/prod/jwt_access_secret (shared by api-server & k8s-streamer)
#    - JWT_REFRESH_SECRET : SSM /envscale/prod/jwt_refresh_secret (must differ from JWT_ACCESS_SECRET)
#    - BETTER_AUTH_SECRET : SSM /envscale/prod/better_auth_secret
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=__SET_VIA_SSM_SECURESTRING_MIN_32_CHARS__
JWT_REFRESH_SECRET=__SET_VIA_SSM_SECURESTRING_DISTINCT_MIN_32_CHARS__
BETTER_AUTH_SECRET=__SET_VIA_SSM_SECURESTRING_MIN_32_CHARS__

# ------------------------------------------------------------------------------
# 4. Kubeconfig Vault Encryption Key (SSM: /envscale/prod/kubeconfig_encryption_key)
#    MUST be an exact 32-byte key encoded in standard Base64 (44 chars ending in '=').
#    Generate out-of-band via: openssl rand -base64 32
# ------------------------------------------------------------------------------
KUBECONFIG_ENCRYPTION_KEY=__SET_VIA_SSM_BASE64_32_BYTE_AES256_KEY__

# ------------------------------------------------------------------------------
# 5. Public Domain, Dynamic DNS & Strict CORS (SSM: /envscale/prod/duckdns_*)
#    Wildcard '*' CORS_ORIGIN is rejected in production.
# ------------------------------------------------------------------------------
DUCKDNS_DOMAIN=envscale
DUCKDNS_TOKEN=__SET_VIA_SSM_SECURESTRING__
BETTER_AUTH_URL=https://envscale.duckdns.org
CORS_ORIGIN=https://envscale.duckdns.org

# ------------------------------------------------------------------------------
# 6. Optional OAuth Providers (Leave empty if credential auth only)
#    SSM: /envscale/prod/google_client_secret, /envscale/prod/github_client_secret
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# 7. Optional Host Port & Path Overrides (Defaults shown; rarely changed in prod)
# ------------------------------------------------------------------------------
# API_HOST_PORT=3001
# STREAMER_HOST_PORT=8080
# WEB_HOST_PORT=3000
# K3S_SOURCE_KUBECONFIG=/etc/rancher/k3s/k3s.yaml
# K3S_KUBECONFIG_HOST_PATH=/etc/envscale/kubeconfig.yaml

