#!/usr/bin/env bash
# ==============================================================================
# EnvScale AI Assistant & Developer Unified CLI (`agent`)
# ==============================================================================

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -f "$SCRIPT_DIR/scripts/agent" ]; then
    exec python3 "$SCRIPT_DIR/scripts/agent" "$@"
else
    echo "Error: scripts/agent executable not found."
    exit 1
fi
