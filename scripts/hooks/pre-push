#!/usr/bin/env bash
# ==============================================================================
# EnvScale Git Pre-Push Guardrail
# Prevents direct pushes to protected 'main' branch
# ==============================================================================

RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

protected_branch="main"

while read -r local_ref local_sha remote_ref remote_sha
do
    if [ "$remote_ref" = "refs/heads/$protected_branch" ]; then
        echo -e "\n${RED}${BOLD}========================================================================${NC}"
        echo -e "${RED}${BOLD}❌ DIRECT PUSH TO 'main' IS STRICTLY PROHIBITED BY ENVSCALE GOVERNANCE!${NC}"
        echo -e "${RED}${BOLD}========================================================================${NC}"
        echo -e "${YELLOW}Per repository rules in AGENTS.md and docs/GIT_GUIDE.md:${NC}"
        echo -e "  - All work must be pushed to your dedicated feature branch (e.g., ${CYAN}feature/vinit-api-server${NC})."
        echo -e "  - Open a Pull Request targeting ${CYAN}develop${NC} for integration testing."
        echo -e "  - Only verified Milestone releases are merged into ${CYAN}main${NC} from ${CYAN}develop${NC}.\n"
        exit 1
    fi
done

exit 0
