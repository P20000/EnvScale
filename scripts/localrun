#!/usr/bin/env python3
import os
import sys
import time
import socket
import signal
import shutil
import threading
import subprocess
import webbrowser

import gi
gi.require_version('Gtk', '3.0')
from gi.repository import Gtk, Gdk, GLib, GObject

SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
PROJECT_ROOT = os.path.abspath(os.path.join(SCRIPT_DIR, ".."))
os.chdir(PROJECT_ROOT)

sys.path.insert(0, SCRIPT_DIR)
from lib.gui_styles import CSS_STYLES
from lib.service_manager import check_port, check_redis
from lib.workers import (
    worker_deploy_k8s,
    worker_teardown_k8s,
    worker_run_tests,
)

class LocalRunApp(Gtk.Window):
    def __init__(self):
        super().__init__(title="EnvScale — Local Environment Manager")
        self.set_default_size(1024, 768)
        self.set_position(Gtk.WindowPosition.CENTER)

        self.running_processes = []
        self.is_busy = False

        style_provider = Gtk.CssProvider()
        style_provider.load_from_data(CSS_STYLES)
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(),
            style_provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        main_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        self.add(main_box)

        header = Gtk.HeaderBar()
        header.set_show_close_button(True)
        header.set_title("EnvScale Local Manager")
        header.set_subtitle("Multi-Tenant Kubernetes Observability Platform")
        self.set_titlebar(header)

        control_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        control_bar.set_margin_start(16)
        control_bar.set_margin_end(16)
        control_bar.set_margin_top(14)
        control_bar.set_margin_bottom(6)

        self.btn_test = Gtk.Button(label="🧪 Run Full Tests")
        self.btn_test.get_style_context().add_class("btn-test")
        self.btn_test.connect("clicked", self.on_run_tests_clicked)

        self.btn_start = Gtk.Button(label="🚀 Launch App Stack")
        self.btn_start.get_style_context().add_class("btn-start")
        self.btn_start.connect("clicked", self.on_start_stack_clicked)

        self.btn_stop = Gtk.Button(label="🛑 Stop Stack")
        self.btn_stop.get_style_context().add_class("btn-stop")
        self.btn_stop.connect("clicked", self.on_stop_stack_clicked)

        self.btn_open = Gtk.Button(label="🌐 Open Web UI")
        self.btn_open.get_style_context().add_class("btn-open")
        self.btn_open.connect("clicked", self.on_open_web_clicked)

        control_bar.pack_start(self.btn_test, False, False, 0)
        control_bar.pack_start(self.btn_start, False, False, 0)
        control_bar.pack_start(self.btn_stop, False, False, 0)
        control_bar.pack_end(self.btn_open, False, False, 0)
        main_box.pack_start(control_bar, False, False, 0)

        k8s_control_bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        k8s_control_bar.set_margin_start(16)
        k8s_control_bar.set_margin_end(16)
        k8s_control_bar.set_margin_top(4)
        k8s_control_bar.set_margin_bottom(12)

        self.btn_deploy_k8s = Gtk.Button(label="☸️ Deploy Minikube Todo App")
        self.btn_deploy_k8s.get_style_context().add_class("btn-k8s-deploy")
        self.btn_deploy_k8s.connect("clicked", self.on_deploy_k8s_clicked)

        self.btn_teardown_k8s = Gtk.Button(label="🗑️ Teardown Minikube Todo App")
        self.btn_teardown_k8s.get_style_context().add_class("btn-k8s-teardown")
        self.btn_teardown_k8s.connect("clicked", self.on_teardown_k8s_clicked)

        self.btn_open_ingress = Gtk.Button(label="🌐 Open Todo Ingress")
        self.btn_open_ingress.get_style_context().add_class("btn-open")
        self.btn_open_ingress.connect("clicked", self.on_open_ingress_clicked)

        k8s_control_bar.pack_start(self.btn_deploy_k8s, False, False, 0)
        k8s_control_bar.pack_start(self.btn_teardown_k8s, False, False, 0)
        k8s_control_bar.pack_end(self.btn_open_ingress, False, False, 0)
        main_box.pack_start(k8s_control_bar, False, False, 0)

        progress_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        progress_box.set_margin_start(16)
        progress_box.set_margin_end(16)
        progress_box.set_margin_bottom(12)

        self.lbl_progress = Gtk.Label(label="Status: Ready")
        self.lbl_progress.set_xalign(0)
        self.lbl_progress.get_style_context().add_class("subtitle-label")

        self.progress_bar = Gtk.ProgressBar()
        self.progress_bar.set_fraction(0.0)

        progress_box.pack_start(self.lbl_progress, False, False, 0)
        progress_box.pack_start(self.progress_bar, False, False, 0)
        main_box.pack_start(progress_box, False, False, 0)

        cards_grid = Gtk.Grid()
        cards_grid.set_column_spacing(12)
        cards_grid.set_row_spacing(12)
        cards_grid.set_column_homogeneous(True)
        cards_grid.set_margin_start(16)
        cards_grid.set_margin_end(16)
        cards_grid.set_margin_bottom(16)

        self.services = {
            "postgres": {"name": "PostgreSQL DB", "port": 5432, "badge": None},
            "redis": {"name": "Redis Cache", "port": 6379, "badge": None},
            "api": {"name": "REST API Server", "port": 3000, "badge": None},
            "streamer": {"name": "K8s Streamer", "port": 8080, "badge": None},
            "web": {"name": "Web Frontend", "port": 5173, "badge": None},
        }

        col = 0
        for key, s in self.services.items():
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            card.get_style_context().add_class("card")

            title = Gtk.Label(label=s["name"])
            title.get_style_context().add_class("card-title")
            title.set_xalign(0)

            badge = Gtk.Label(label="OFFLINE")
            badge.get_style_context().add_class("badge-offline")
            badge.set_xalign(0)
            s["badge"] = badge

            card.pack_start(title, False, False, 0)
            card.pack_start(badge, False, False, 0)
            cards_grid.attach(card, col, 0, 1, 1)
            col += 1

        main_box.pack_start(cards_grid, False, False, 0)

        log_frame = Gtk.Frame(label=" Live Output Log ")
        log_frame.set_margin_start(16)
        log_frame.set_margin_end(16)
        log_frame.set_margin_bottom(16)

        scrolled = Gtk.ScrolledWindow()
        scrolled.set_hexpand(True)
        scrolled.set_vexpand(True)

        self.text_view = Gtk.TextView()
        self.text_view.set_editable(False)
        self.text_view.set_cursor_visible(False)
        self.text_buffer = self.text_view.get_buffer()

        scrolled.add(self.text_view)
        log_frame.add(scrolled)
        main_box.pack_start(log_frame, True, True, 0)

        self.connect("destroy", self.on_window_destroy)

        GLib.timeout_add(3000, self.update_health_badges)
        self.update_health_badges()

        self.append_log("=== EnvScale Local Environment Manager Initialized ===")
        self.append_log(f"Project Root: {PROJECT_ROOT}\n")

    def append_log(self, text):
        def _update():
            end_iter = self.text_buffer.get_end_iter()
            self.text_buffer.insert(end_iter, text + "\n")
            mark = self.text_buffer.create_mark(None, self.text_buffer.get_end_iter(), False)
            self.text_view.scroll_to_mark(mark, 0.0, True, 0.0, 1.0)
            return False
        GLib.idle_add(_update)

    def set_status(self, text, fraction=0.0):
        def _update():
            self.lbl_progress.set_text(f"Status: {text}")
            self.progress_bar.set_fraction(fraction)
            return False
        GLib.idle_add(_update)

    def update_health_badges(self):
        for name, s in self.services.items():
            port = s["port"]
            badge = s["badge"]
            if name == "redis":
                is_up = check_redis(port)
            else:
                is_up = check_port(port)
            if is_up:
                badge.set_text(f"ONLINE (:{port})")
                badge.get_style_context().remove_class("badge-offline")
                badge.get_style_context().add_class("badge-online")
            else:
                badge.set_text(f"OFFLINE (:{port})")
                badge.get_style_context().remove_class("badge-online")
                badge.get_style_context().add_class("badge-offline")
        return True

    def on_run_tests_clicked(self, widget):
        if self.is_busy:
            return
        threading.Thread(target=worker_run_tests, args=(self, PROJECT_ROOT), daemon=True).start()

    def on_start_stack_clicked(self, widget):
        if self.is_busy:
            return
        threading.Thread(target=self._worker_start_stack, daemon=True).start()

    def on_stop_stack_clicked(self, widget):
        threading.Thread(target=self._worker_stop_stack, daemon=True).start()

    def on_open_web_clicked(self, widget):
        webbrowser.open("http://localhost:5173")

    def on_deploy_k8s_clicked(self, widget):
        if self.is_busy:
            return
        threading.Thread(target=worker_deploy_k8s, args=(self, PROJECT_ROOT), daemon=True).start()

    def on_teardown_k8s_clicked(self, widget):
        if self.is_busy:
            return
        threading.Thread(target=worker_teardown_k8s, args=(self, PROJECT_ROOT), daemon=True).start()

    def on_open_ingress_clicked(self, widget):
        threading.Thread(target=self._worker_open_ingress, daemon=True).start()

    def _worker_open_ingress(self):
        ip_res = subprocess.run("minikube ip", shell=True, capture_output=True, text=True)
        mk_ip = ip_res.stdout.strip()
        if mk_ip:
            url = f"http://{mk_ip}/"
            self.append_log(f"[OPEN] Opening Todo Ingress: {url}")
            webbrowser.open(url)
        else:
            self.append_log("[ERROR] Minikube is not running or IP unavailable.")

    def _worker_start_stack(self):
        self.is_busy = True
        self.append_log("\n[STACK] Launching full local application environment...")

        subprocess.run("docker compose -f docker-compose.dev.yml down --remove-orphans", shell=True, cwd=PROJECT_ROOT, stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
        subprocess.run("docker rm -f envscale-redis envscale-postgres 2>/dev/null", shell=True, stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
        subprocess.run("fuser -k -9 3000/tcp 8080/tcp 5173/tcp 6379/tcp 5432/tcp 2>/dev/null", shell=True, stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)

        self.set_status("Provisioning environment secrets...", 0.2)
        env_path = os.path.join(PROJECT_ROOT, "apps/api-server/.env")
        if not os.path.exists(env_path):
            example_path = os.path.join(PROJECT_ROOT, "apps/api-server/.env.example")
            if os.path.exists(example_path):
                shutil.copyfile(example_path, env_path)
                self.append_log("[ENV] Created apps/api-server/.env from .env.example")
            else:
                with open(env_path, "w") as f:
                    f.write("DATABASE_URL=postgresql://envscale:envscale_password@localhost:5432/envscale\n")
                    f.write("JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret\n")
                    f.write("JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret\n")
                    f.write("KUBECONFIG_ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtYmFzZTY0LWtleS0xMjM=\n")
                    f.write("CORS_ORIGIN=http://localhost:5173\n")
                    f.write("PORT=3000\nNODE_ENV=development\n")
                self.append_log("[ENV] Generated default apps/api-server/.env")

        streamer_env_path = os.path.join(PROJECT_ROOT, "apps/k8s-streamer/.env")
        if not os.path.exists(streamer_env_path):
            streamer_example_path = os.path.join(PROJECT_ROOT, "apps/k8s-streamer/.env.example")
            if os.path.exists(streamer_example_path):
                shutil.copyfile(streamer_example_path, streamer_env_path)
                self.append_log("[ENV] Created apps/k8s-streamer/.env from .env.example")
            else:
                with open(streamer_env_path, "w") as f:
                    f.write("PORT=8080\nNODE_ENV=development\n")
                    f.write("JWT_ACCESS_SECRET=342d2b89c945a82109fe28d7cfe42e9b53ff70d0ceff44316afe2250604d5a92\n")
                    f.write("ALLOW_ANONYMOUS_WS=true\n")
                    f.write("REDIS_URL=redis://localhost:6379\n")
                self.append_log("[ENV] Generated default apps/k8s-streamer/.env")

        self.set_status("Starting PostgreSQL & Redis containers...", 0.4)
        self.append_log("[DOCKER] Running 'docker compose -f docker-compose.dev.yml up -d --remove-orphans'...")
        exit_code = self._exec_cmd("docker compose -f docker-compose.dev.yml up -d --remove-orphans", cwd=PROJECT_ROOT)
        if exit_code != 0:
            self.append_log("⚠️ [DOCKER] Container launch reported an error code. Verifying service port availability...")
            if check_port(6379) and not check_redis(6379):
                self.append_log("❌ [PORT CLASH] Port 6379 is bound by a non-Redis process or host systemd service (e.g., 'sudo systemctl stop redis-server').")

        self.append_log("[DB] Waiting for PostgreSQL & Redis database readiness...")
        attempts = 0
        while attempts < 15:
            if check_port(5432) and check_redis(6379):
                break
            time.sleep(1)
            attempts += 1

        self.set_status("Syncing Drizzle database schema...", 0.6)
        self.append_log("[DB] Applying Drizzle schema migrations...")
        self._exec_cmd("npx drizzle-kit push:pg", cwd=os.path.join(PROJECT_ROOT, "apps/api-server"))

        self.set_status("Spawning application microservices...", 0.8)
        self._spawn_service("API Server", ["npx", "tsx", "watch", "src/index.ts"], os.path.join(PROJECT_ROOT, "apps/api-server"))
        self._spawn_service("K8s Streamer", ["go", "run", "./cmd/server/main.go"], os.path.join(PROJECT_ROOT, "apps/k8s-streamer"))
        self._spawn_service("Web Frontend", ["npx", "vite"], os.path.join(PROJECT_ROOT, "apps/web"))

        # Auto-registration disabled: User should manually register clusters via the UI.
        # threading.Thread(target=self._auto_register_cluster, daemon=True).start()

        self.set_status("Application Stack is RUNNING online!", 1.0)
        self.append_log("\n[SUCCESS] LOCAL APPLICATION STACK IS FULLY RUNNING! 🎉")
        self.append_log("   - Web Frontend UI:  http://localhost:5173")
        self.append_log("   - REST API Engine:  http://localhost:3000")
        self.append_log("   - Streaming Gateway: http://localhost:8080\n")
        self.is_busy = False

    def _auto_register_cluster(self):
        time.sleep(3)
        self.append_log("[AUTO-REGISTER] Attempting to auto-register minikube cluster to streaming gateway...")
        flat_path = "/tmp/minikube-flat.yaml"
        if not os.path.exists(flat_path):
            subprocess.run(f"kubectl config view --flatten > {flat_path}", shell=True)

        if os.path.exists(flat_path):
            import json
            import urllib.request
            import base64
            try:
                with open(flat_path, "r") as f:
                    kubeconfig = f.read()
                b64_kubeconfig = base64.b64encode(kubeconfig.encode()).decode()
                req = urllib.request.Request("http://localhost:8080/api/v1/clusters/register", method="POST")
                req.add_header("Content-Type", "application/json")
                data = json.dumps({"clusterId": "minikube", "kubeconfig": b64_kubeconfig}).encode()
                urllib.request.urlopen(req, data=data, timeout=10)
                self.append_log("[AUTO-REGISTER] ✅ Automatically registered 'minikube' cluster with streaming gateway!")
            except Exception as e:
                self.append_log(f"[AUTO-REGISTER] ❌ Failed to auto-register cluster: {e}")

    def _worker_stop_stack(self):
        self.append_log("\n[STOP] Stopping all microservices and spinning down containers...")
        self.set_status("Stopping running services...", 0.5)

        for name, proc in list(self.running_processes):
            try:
                pgid = os.getpgid(proc.pid)
                os.killpg(pgid, signal.SIGTERM)
                proc.wait(timeout=2)
                self.append_log(f"[STOP] Terminated process group for {name}")
            except Exception:
                try:
                    pgid = os.getpgid(proc.pid)
                    os.killpg(pgid, signal.SIGKILL)
                except Exception:
                    pass
        self.running_processes.clear()

        self.append_log("[STOP] Force clearing service ports (3000, 8080, 5173, 6379, 5432)...")
        subprocess.run("fuser -k -9 3000/tcp 8080/tcp 5173/tcp 6379/tcp 5432/tcp 2>/dev/null", shell=True, stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)

        self._exec_cmd("docker compose -f docker-compose.dev.yml down --remove-orphans", cwd=PROJECT_ROOT)
        self.append_log("[DOCKER] Containers spun down cleanly.")
        self.set_status("All services stopped.", 0.0)
        self.update_health_badges()
        self.append_log("[SUCCESS] APPLICATION STACK SPUN DOWN.\n")

    def _parse_dotenv(self, filepath):
        env_dict = {}
        if os.path.exists(filepath):
            try:
                with open(filepath, "r") as f:
                    for line in f:
                        line = line.strip()
                        if line and not line.startswith("#") and "=" in line:
                            k, v = line.split("=", 1)
                            env_dict[k.strip()] = v.strip().strip("'\"")
            except Exception:
                pass
        return env_dict

    def _spawn_service(self, name, cmd_args, cwd):
        self.append_log(f"[SPAWN] Starting {name}...")
        proc_env = os.environ.copy()
        dotenv_path = os.path.join(cwd, ".env")
        proc_env.update(self._parse_dotenv(dotenv_path))

        proc = subprocess.Popen(
            cmd_args,
            cwd=cwd,
            env=proc_env,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            preexec_fn=os.setsid
        )
        self.running_processes.append((name, proc))

        def _read():
            try:
                for line in proc.stdout:
                    line_str = line.strip()
                    if line_str:
                        self.append_log(f"[{name}] {line_str}")
            except Exception:
                pass
        threading.Thread(target=_read, daemon=True).start()

    def _exec_cmd(self, command_str, cwd=None):
        proc = subprocess.Popen(
            command_str,
            shell=True,
            cwd=cwd or PROJECT_ROOT,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            preexec_fn=os.setsid
        )
        for line in proc.stdout:
            l = line.strip()
            if l:
                self.append_log(l)
        proc.wait()
        return proc.returncode

    def on_window_destroy(self, widget):
        for name, proc in list(self.running_processes):
            try:
                pgid = os.getpgid(proc.pid)
                os.killpg(pgid, signal.SIGKILL)
            except Exception:
                pass
        subprocess.run("fuser -k -9 3000/tcp 8080/tcp 5173/tcp", shell=True, stderr=subprocess.DEVNULL, stdout=subprocess.DEVNULL)
        Gtk.main_quit()

def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    app = LocalRunApp()
    app.show_all()
    Gtk.main()

if __name__ == "__main__":
    main()
