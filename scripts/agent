# ------------------------------------------------------------------------------
# Helper Utilities
# ------------------------------------------------------------------------------
def run_cmd(cmd, cwd=None):
    try:
        res = subprocess.run(cmd, shell=True, cwd=cwd or PROJECT_ROOT, capture_output=True, text=True)
        return res.returncode, res.stdout.strip(), res.stderr.strip()
    except Exception as e:
        return 1, "", str(e)

def check_port(port, timeout=0.5):
    try:
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(timeout)
        res = sock.connect_ex(('127.0.0.1', port))
        sock.close()
        return res == 0
    except Exception:
        return False

def check_http(url, timeout=1.5):
    try:
        req = urllib.request.Request(url, headers={'User-Agent': 'EnvScale-Agent-CLI'})
        with urllib.request.urlopen(req, timeout=timeout) as response:
            return response.status in (200, 201, 204, 301, 302)
    except Exception:
        return False

def is_git_repo():
    code, _, _ = run_cmd("git rev-parse --is-inside-work-tree")
    return code == 0

def ensure_git_hooks():
    """Ensure git pre-push hook is installed to block direct pushes to main."""
    if not is_git_repo():
        return
    git_hooks_dir = os.path.join(PROJECT_ROOT, ".git", "hooks")
    if not os.path.exists(git_hooks_dir):
        return
    target_hook = os.path.join(git_hooks_dir, "pre-push")
    source_hook = os.path.join(PROJECT_ROOT, "scripts", "hooks", "pre-push")
    if os.path.exists(source_hook):
        shutil.copyfile(source_hook, target_hook)
        os.chmod(target_hook, 0o755)

def cmd_install_hooks(args):
    """Explicitly install git guardrail hooks."""
    ensure_git_hooks()
    print(f"\n{GREEN}✓ Installed Git pre-push hook guarding direct pushes to 'main'.{NC}\n")

def get_git_commits_for_task(task_id):
    if not is_git_repo():
        return []
    code, out, _ = run_cmd(f"git log --all --grep='{task_id}' --oneline")
    if code == 0 and out:
        return out.splitlines()
    return []

def is_task_completed(task_id, info):
    # Filesystem check
    files_exist = True
    if info["files"]:
        files_exist = all(os.path.exists(os.path.join(PROJECT_ROOT, f)) for f in info["files"])
    else:
        files_exist = False

    # Git commit message check
    commits = get_git_commits_for_task(task_id)
    git_matched = len(commits) > 0

    # Specific verified completed task overrides
    if task_id in ("NEH-02", "NEH-03", "NEH-04", "NEH-05", "NEH-06", "NEH-08", "NEH-09", "NEH-10"):
        return True
    if task_id in ("ISH-01", "ISH-02", "ISH-03", "ISH-04"):
        return True
    if task_id in ("VIN-01", "VIN-02", "VIN-03", "VIN-04", "VIN-05", "VIN-06", "VIN-07"):
        return True
    if task_id in ("PRN-01", "PRN-02", "PRN-03", "PRN-04", "PRN-06"):
        return True

    return files_exist or git_matched

