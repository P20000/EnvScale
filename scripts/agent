# Core Agent Commands
# ------------------------------------------------------------------------------

def cmd_check(args):
    """Priority 1: One-shot build, typecheck, and lint verification across monorepo."""
    json_mode = getattr(args, "json", False)
    results = {}

    if not json_mode:
        print(f"\n{BOLD}{CYAN}=== EnvScale Monorepo Build & Verification Check ==={NC}\n")

    # 1. apps/web Typecheck & Lint
    if not json_mode:
        print(f"{YELLOW}[1/4] Checking apps/web (TypeScript & ESLint)...{NC}")
    code, out, err = run_cmd("npx tsc -b && npx eslint src --max-warnings 0", cwd=os.path.join(PROJECT_ROOT, "apps/web"))
    results["web"] = {"status": "PASS" if code == 0 else "FAIL", "output": out or err}

    # 2. apps/api-server Typecheck
    if not json_mode:
        print(f"{YELLOW}[2/4] Checking apps/api-server (TypeScript)...{NC}")
    code, out, err = run_cmd("npx tsc --noEmit", cwd=os.path.join(PROJECT_ROOT, "apps/api-server"))
    results["api_server"] = {"status": "PASS" if code == 0 else "FAIL", "output": out or err}

    # 3. apps/k8s-streamer Go Build
    if not json_mode:
        print(f"{YELLOW}[3/4] Checking apps/k8s-streamer (Go Compilation)...{NC}")
    code, out, err = run_cmd("go build -o /tmp/k8s-streamer-agent-test ./cmd/server/main.go", cwd=os.path.join(PROJECT_ROOT, "apps/k8s-streamer"))
    if os.path.exists("/tmp/k8s-streamer-agent-test"):
        os.remove("/tmp/k8s-streamer-agent-test")
    results["k8s_streamer"] = {"status": "PASS" if code == 0 else "FAIL", "output": out or err}

    # 4. Drizzle ORM Schema Declaration
    if not json_mode:
        print(f"{YELLOW}[4/4] Checking Drizzle ORM Schema Declaration...{NC}")
    code, out, err = run_cmd("npx tsc --noEmit -p tsconfig.json", cwd=os.path.join(PROJECT_ROOT, "apps/api-server"))
    results["drizzle"] = {"status": "PASS" if code == 0 else "FAIL", "output": out or err}

    all_passed = all(v["status"] == "PASS" for v in results.values())

    if json_mode:
        print(json.dumps({"overall": "PASS" if all_passed else "FAIL", "results": results}, indent=2))
    else:
        print(f"\n{BOLD}Verification Results Summary:{NC}")
        for app, res in results.items():
            status_badge = f"{GREEN}✓ PASS{NC}" if res["status"] == "PASS" else f"{RED}✗ FAIL{NC}"
            print(f"  - {app.ljust(15)} : {status_badge}")
        if all_passed:
            print(f"\n{GREEN}{BOLD}🚀 ALL MONOREPO BUILD & LINT CHECKS PASSED PERFECTLY!{NC}\n")
        else:
            print(f"\n{RED}{BOLD}❌ VERIFICATION FAILED: Fix reported compilation/lint errors above.{NC}\n")
            sys.exit(1)


def cmd_demo_check(args):
    """Priority 1: Pre-defense smoke test verifying Docker, APIs, WebSocket, and Frontend."""
    json_mode = getattr(args, "json", False)

    checks = [
        {"name": "PostgreSQL Database", "port": 5432, "type": "port"},
        {"name": "Redis Cache Server", "port": 6379, "type": "port"},
        {"name": "REST API Server (/health)", "url": "http://localhost:3000/health", "type": "http"},
        {"name": "K8s Streamer Gateway (/health)", "url": "http://localhost:8080/health", "type": "http"},
        {"name": "React Web Frontend UI", "url": "http://localhost:5173", "type": "http"},
    ]

    results = []

    if not json_mode:
        print(f"\n{BOLD}{CYAN}=== EnvScale Pre-Defense Smoke Test (Demo Check) ==={NC}\n")

    for c in checks:
        if c["type"] == "port":
            is_up = check_port(c["port"])
        else:
            is_up = check_http(c["url"])

        status = "ONLINE" if is_up else "OFFLINE"
        results.append({"name": c["name"], "status": status, "target": c.get("url") or f"Port {c['port']}"})

        if not json_mode:
            badge = f"{GREEN}🟢 ONLINE{NC}" if is_up else f"{RED}🔴 OFFLINE{NC}"
            target_str = f"({c.get('url') or 'Port ' + str(c['port'])})"
            print(f"  {badge}  {c['name'].ljust(32)} {DIM}{target_str}{NC}")

    all_online = all(r["status"] == "ONLINE" for r in results)
    readiness = 100 if all_online else int((sum(1 for r in results if r["status"] == "ONLINE") / len(results)) * 100)

    if json_mode:
        print(json.dumps({"readiness_percent": readiness, "all_online": all_online, "checks": results}, indent=2))
    else:
        print(f"\n{BOLD}Defense Readiness Score: {CYAN}{readiness}%{NC}")
        if all_online:
            print(f"{GREEN}{BOLD}🎉 ALL SYSTEMS GO! Local environment is 100% ready for project defense demo.{NC}\n")
        else:
            print(f"{YELLOW}⚠️  Note: Run 'python3 scripts/localrun' or launch missing microservices before demo.{NC}\n")


def cmd_summary(args):
    """Priority 2: Git-history and filesystem aware status check across all tasks."""
    json_mode = getattr(args, "json", False) or not sys.stdout.isatty() and not getattr(args, "human", False)

    completed_count = 0
    total_count = len(TASK_DB)
    owner_stats = {}
    milestone_stats = {1: {"done": 0, "total": 0}, 2: {"done": 0, "total": 0}, 3: {"done": 0, "total": 0}, 4: {"done": 0, "total": 0}}
    task_results = {}

    for task_id, info in TASK_DB.items():
        owner = info["owner"]
        ms = info["milestone"]

        if owner not in owner_stats:
            owner_stats[owner] = {"done": 0, "total": 0}

        owner_stats[owner]["total"] += 1
        milestone_stats[ms]["total"] += 1

        done = is_task_completed(task_id, info)
        if done:
            completed_count += 1
            owner_stats[owner]["done"] += 1
            milestone_stats[ms]["done"] += 1

        task_results[task_id] = {
            "title": info["title"],
            "owner": owner,
            "milestone": ms,
            "status": "DONE" if done else "PENDING",
        }

    if json_mode and not getattr(args, "human", False):
        out_data = {
            "summary": {
                "completed": completed_count,
                "total": total_count,
                "percentage": round((completed_count / total_count) * 100, 1),
            },
            "owner_breakdown": owner_stats,
            "milestone_breakdown": milestone_stats,
            "tasks": task_results,
        }
        print(json.dumps(out_data, indent=2))
        return

    # Human-Skimmable Terminal View
    print(f"\n{BOLD}{CYAN}=== EnvScale Project Task Completion Summary ==={NC}\n")

    print(f"{BOLD}Overall Progress:{NC} {GREEN}{completed_count}/{total_count}{NC} tasks completed ({round((completed_count/total_count)*100)}%)\n")

    print(f"{BOLD}Progress by Team Member:{NC}")
    for owner, s in owner_stats.items():
        pct = round((s["done"] / s["total"]) * 100) if s["total"] > 0 else 0
        bar_len = 15
        filled = int((pct / 100) * bar_len)
        bar = "█" * filled + "░" * (bar_len - filled)
        color = GREEN if pct == 100 else (CYAN if pct >= 50 else YELLOW)
        print(f"  {owner.ljust(10)} [{color}{bar}{NC}] {s['done']}/{s['total']} tasks ({pct}%)")

    print(f"\n{BOLD}Progress by Milestone:{NC}")
    for ms, s in milestone_stats.items():
        pct = round((s["done"] / s["total"]) * 100) if s["total"] > 0 else 0
        bar_len = 15
        filled = int((pct / 100) * bar_len)
        bar = "█" * filled + "░" * (bar_len - filled)
        color = GREEN if pct == 100 else (CYAN if pct >= 50 else YELLOW)
        print(f"  Milestone {ms}: [{color}{bar}{NC}] {s['done']}/{s['total']} tasks ({pct}%)")

    print(f"\n{BOLD}Task Breakdown Details:{NC}")
    for task_id, res in task_results.items():
        badge = f"{GREEN}[DONE]{NC}" if res["status"] == "DONE" else f"{RED}[PENDING]{NC}"
        print(f"  {badge} {task_id.ljust(8)} | M{res['milestone']} | {res['owner'].ljust(8)} | {res['title']}")
    print()


def audit_single_task(task_id):
    """Perform structural code and git verification for a single task ID."""
    task_id = task_id.upper()
    if task_id not in TASK_DB:
        return None

    info = TASK_DB[task_id]
    audit_items = []

    # File existence check
    for f in info["files"]:
        full_p = os.path.join(PROJECT_ROOT, f)
        exists = os.path.exists(full_p)
        audit_items.append({"item": f"File: {f}", "status": "PASS" if exists else "FAIL"})

    # Specific code inspections
    schema_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/db/schema.ts")
    idx_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/index.ts")

    schema_content = ""
    if os.path.exists(schema_p):
        with open(schema_p, "r") as fp:
            schema_content = fp.read()

    index_content = ""
    if os.path.exists(idx_p):
        with open(idx_p, "r") as fp:
            index_content = fp.read()

    if task_id == "VIN-08":
        has_schema = "export const alertPolicies" in schema_content
        audit_items.append({"item": "DB Schema table (alertPolicies in schema.ts)", "status": "PASS" if has_schema else "FAIL"})
        ctrl_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/controllers/alert.controller.ts")
        audit_items.append({"item": "Alert Controller (alert.controller.ts)", "status": "PASS" if os.path.exists(ctrl_p) else "FAIL"})
        route_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/routes/alert.routes.ts")
        audit_items.append({"item": "Alert Router (alert.routes.ts)", "status": "PASS" if os.path.exists(route_p) else "FAIL"})
        has_mount = "alertPolicies" in index_content or "alertRouter" in index_content
        audit_items.append({"item": "Mounted in apps/api-server/src/index.ts", "status": "PASS" if has_mount else "FAIL"})

    elif task_id == "VIN-09":
        has_schema = "export const incidents" in schema_content
        audit_items.append({"item": "DB Schema table (incidents in schema.ts)", "status": "PASS" if has_schema else "FAIL"})
        ctrl_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/controllers/incident.controller.ts")
        audit_items.append({"item": "Incident Controller (incident.controller.ts)", "status": "PASS" if os.path.exists(ctrl_p) else "FAIL"})
        srv_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/services/incident.service.ts")
        audit_items.append({"item": "Incident Service (incident.service.ts)", "status": "PASS" if os.path.exists(srv_p) else "FAIL"})
        route_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/routes/incident.routes.ts")
        audit_items.append({"item": "Incident Router (incident.routes.ts)", "status": "PASS" if os.path.exists(route_p) else "FAIL"})
        has_mount = "incidentRouter" in index_content or "incidents" in index_content
        audit_items.append({"item": "Mounted in apps/api-server/src/index.ts", "status": "PASS" if has_mount else "FAIL"})

    elif task_id == "VIN-10":
        has_schema = "export const healthSnapshots" in schema_content
        audit_items.append({"item": "DB Schema table (healthSnapshots in schema.ts)", "status": "PASS" if has_schema else "FAIL"})
        srv_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/services/health-calculator.service.ts")
        audit_items.append({"item": "Health Calculator Service (health-calculator.service.ts)", "status": "PASS" if os.path.exists(srv_p) else "FAIL"})
        wrk_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/workers/snapshot.worker.ts")
        audit_items.append({"item": "Snapshot Background Worker (snapshot.worker.ts)", "status": "PASS" if os.path.exists(wrk_p) else "FAIL"})

    elif task_id == "VIN-11":
        ctrl_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/controllers/leaderboard.controller.ts")
        audit_items.append({"item": "Leaderboard Controller (leaderboard.controller.ts)", "status": "PASS" if os.path.exists(ctrl_p) else "FAIL"})
        has_mount = "leaderboard" in index_content
        audit_items.append({"item": "Mounted in apps/api-server/src/index.ts", "status": "PASS" if has_mount else "FAIL"})

    elif task_id == "VIN-04":
        ctrl_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/controllers/auth.controller.ts")
        audit_items.append({"item": "Auth Controller (auth.controller.ts)", "status": "PASS" if os.path.exists(ctrl_p) else "FAIL"})
        has_mount = "authRouter" in index_content
        audit_items.append({"item": "Mounted in apps/api-server/src/index.ts", "status": "PASS" if has_mount else "FAIL"})

    elif task_id == "VIN-05":
        ctrl_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/controllers/workspace.controller.ts")
        audit_items.append({"item": "Workspace Controller (workspace.controller.ts)", "status": "PASS" if os.path.exists(ctrl_p) else "FAIL"})
        has_mount = "workspaceRouter" in index_content
        audit_items.append({"item": "Mounted in apps/api-server/src/index.ts", "status": "PASS" if has_mount else "FAIL"})

    elif task_id == "VIN-06":
        crypto_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/utils/crypto.ts")
        audit_items.append({"item": "AES-256 Crypto Module (crypto.ts)", "status": "PASS" if os.path.exists(crypto_p) else "FAIL"})
        ctrl_p = os.path.join(PROJECT_ROOT, "apps/api-server/src/controllers/cluster.controller.ts")
        audit_items.append({"item": "Cluster Controller (cluster.controller.ts)", "status": "PASS" if os.path.exists(ctrl_p) else "FAIL"})
        has_mount = "clusterRouter" in index_content
        audit_items.append({"item": "Mounted in apps/api-server/src/index.ts", "status": "PASS" if has_mount else "FAIL"})

    commits = get_git_commits_for_task(task_id)
    audit_items.append({"item": f"Git Commits matching '{task_id}'", "status": "PASS" if commits else "FAIL", "count": len(commits)})

    is_complete = all(i["status"] == "PASS" for i in audit_items if not i["item"].startswith("Git"))

    return {
        "task_id": task_id,
        "title": info["title"],
        "owner": info["owner"],
        "milestone": info["milestone"],
        "module": info["module"],
        "is_completed": is_complete,
        "audit": audit_items,
        "git_commits": commits,
    }


def cmd_audit(args):
    """Priority 2: Deep structural audit for targeted task IDs, assignee, or review tasks."""
    json_mode = getattr(args, "json", False)
    target_tasks = []

    raw_ids = getattr(args, "task_ids", []) or []
    assignee = getattr(args, "assignee", None)
    review_mode = getattr(args, "review", False)

    if raw_ids:
        for tid in raw_ids:
            tid_upper = tid.upper()
            if tid_upper in TASK_DB:
                target_tasks.append(tid_upper)
            else:
                print(f"{YELLOW}Warning: Task ID '{tid}' not found in task matrix.{NC}")

    if review_mode:
        for tid, info in TASK_DB.items():
            if tid not in target_tasks:
                if info["milestone"] >= 3 or not is_task_completed(tid, info):
                    if assignee:
                        if info["owner"].lower() == assignee.lower():
                            target_tasks.append(tid)
                    else:
                        target_tasks.append(tid)

    elif assignee and not raw_ids:
        for tid, info in TASK_DB.items():
            if info["owner"].lower() == assignee.lower():
                target_tasks.append(tid)

    if not target_tasks:
        print(f"{RED}Error: No valid Task IDs specified. Use task IDs (e.g. VIN-08 VIN-09), --assignee Vinit, or --review.{NC}")
        sys.exit(1)

    results = []
    for tid in target_tasks:
        res = audit_single_task(tid)
        if res:
            results.append(res)

    if json_mode:
        print(json.dumps(results, indent=2))
        return

    print(f"\n{BOLD}{CYAN}=== EnvScale Multi-Task Structural Audit Report ==={NC}\n")
    print(f"Total Tasks Audited: {BOLD}{len(results)}{NC}\n")

    completed_count = sum(1 for r in results if r["is_completed"])

    for r in results:
        status_badge = f"{GREEN}✅ COMPLETE{NC}" if r["is_completed"] else f"{RED}❌ INCOMPLETE{NC}"
        print(f"{BOLD}[{r['task_id']}]{NC} {r['title']} ({r['owner']}) - Status: {status_badge}")
        print(f"  Owner: {r['owner']} | Milestone: M{r['milestone']} | Module: {r['module']}")
        print(f"  Checklist:")
        for item in r["audit"]:
            badge = f"{GREEN}✓ PASS{NC}" if item["status"] == "PASS" else f"{RED}✗ FAIL{NC}"
            print(f"    {badge}  {item['item']}")
        print()

    print(f"{BOLD}Summary Result:{NC} {GREEN if completed_count == len(results) else RED}{completed_count}/{len(results)} tasks fully complete and verified.{NC}\n")



def cmd_owner(args):
    """Priority 3: Ownership & load mapping with commit staleness indicators."""
    json_mode = getattr(args, "json", False)

    owners = ["Vinit", "Pranav", "Neha", "Ishika"]
    stats = {}

    for o in owners:
        stats[o] = {"done": 0, "pending": 0, "total": 0, "last_commit_date": "N/A"}

    for task_id, info in TASK_DB.items():
        o = info["owner"]
        done = is_task_completed(task_id, info)
        stats[o]["total"] += 1
        if done:
            stats[o]["done"] += 1
        else:
            stats[o]["pending"] += 1

    # Check last commit date per owner
    if is_git_repo():
        for o in owners:
            code, out, _ = run_cmd(f"git log --author='{o}' -n 1 --format='%cd' --date=short")
            if code == 0 and out:
                stats[o]["last_commit_date"] = out

    if json_mode:
        print(json.dumps(stats, indent=2))
        return

    print(f"\n{BOLD}{CYAN}=== Team Ownership & Workload Mapping ==={NC}\n")
    for o, s in stats.items():
        pct = round((s["done"] / s["total"]) * 100) if s["total"] > 0 else 0
        status_str = f"{GREEN}On Track{NC}" if pct >= 50 else f"{YELLOW}Needs Attention{NC}"
        print(f"  {BOLD}{o.ljust(8)}{NC} : {s['done']} done, {s['pending']} pending (Total: {s['total']}) | Status: {status_str}")
        print(f"             Last Active Commit: {DIM}{s['last_commit_date']}{NC}\n")


def cmd_env(args):
    """Priority 3: Environment & config drift check."""
    json_mode = getattr(args, "json", False)
    env_checks = [
        {"app": "apps/api-server", "example": "apps/api-server/.env.example", "actual": "apps/api-server/.env"},
    ]

    results = []
    for ec in env_checks:
        ex_path = os.path.join(PROJECT_ROOT, ec["example"])
        ac_path = os.path.join(PROJECT_ROOT, ec["actual"])

        if not os.path.exists(ac_path):
            results.append({"app": ec["app"], "status": "MISSING", "missing_keys": []})
            continue

        ex_keys = set()
        if os.path.exists(ex_path):
            with open(ex_path, "r") as f:
                for line in f:
                    line = line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        ex_keys.add(line.split("=")[0].strip())

        ac_keys = set()
        with open(ac_path, "r") as f:
            for line in f:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    ac_keys.add(line.split("=")[0].strip())

        missing = list(ex_keys - ac_keys)
        results.append({"app": ec["app"], "status": "DRIFT" if missing else "OK", "missing_keys": missing})

    if json_mode:
        print(json.dumps(results, indent=2))
        return

    print(f"\n{BOLD}{CYAN}=== Environment & Secrets Config Drift Check ==={NC}\n")
    for r in results:
        if r["status"] == "OK":
            print(f"  {GREEN}✓ PASS{NC} {r['app']} .env file is in sync with template.")
        elif r["status"] == "MISSING":
            print(f"  {RED}✗ MISSING{NC} {r['app']}/.env does not exist! Copy from .env.example.")
        else:
            print(f"  {YELLOW}⚠️  DRIFT{NC} {r['app']}/.env is missing keys: {', '.join(r['missing_keys'])}")
    print()


def cmd_blocked(args):
    """Priority 3: Dependency-aware blocker detection."""
    json_mode = getattr(args, "json", False)
    blocked_tasks = []

    for task_id, info in TASK_DB.items():
        if is_task_completed(task_id, info):
            continue

        unresolved_deps = []
        for dep_id in info["deps"]:
            if dep_id in TASK_DB and not is_task_completed(dep_id, TASK_DB[dep_id]):
                unresolved_deps.append(dep_id)

        if unresolved_deps:
            blocked_tasks.append({"task_id": task_id, "title": info["title"], "owner": info["owner"], "blocked_by": unresolved_deps})

    if json_mode:
        print(json.dumps(blocked_tasks, indent=2))
        return

    print(f"\n{BOLD}{CYAN}=== Dependency-Aware Blocker Report ==={NC}\n")
    if not blocked_tasks:
        print(f"  {GREEN}🎉 No tasks are currently blocked by incomplete dependencies!{NC}\n")
        return

    for bt in blocked_tasks:
        deps_str = ", ".join(bt["blocked_by"])
        print(f"  {YELLOW}🚫 [{bt['task_id']}]{NC} {bt['title']} ({bt['owner']})")
        print(f"     └─ {RED}Blocked by pending prerequisite: {deps_str}{NC}")
    print()


def cmd_diff(args):
    """Priority 4: Diff target branch against develop and map modified files to task IDs."""
    target_branch = getattr(args, "branch", None) or "HEAD"
    json_mode = getattr(args, "json", False)

    code, out, _ = run_cmd(f"git diff --name-only develop...{target_branch}")
    if code != 0 or not out:
        code, out, _ = run_cmd(f"git status --porcelain")

    files_changed = out.splitlines() if out else []
    matched_tasks = set()

    for f in files_changed:
        clean_f = f.strip().split()[-1]
        for task_id, info in TASK_DB.items():
            if clean_f in info["files"]:
                matched_tasks.add(task_id)

    if json_mode:
        print(json.dumps({"branch": target_branch, "files_changed": files_changed, "matched_tasks": list(matched_tasks)}, indent=2))
        return

    print(f"\n{BOLD}{CYAN}=== Branch Task Diff ({target_branch} vs develop) ==={NC}\n")
    print(f"Modified Files Count: {len(files_changed)}")
    print(f"Matched Task IDs    : {', '.join(sorted(matched_tasks)) if matched_tasks else 'None'}\n")

# ------------------------------------------------------------------------------
# GitHub Issue Management PM Commands (Retained from ghissue / pm)
# ------------------------------------------------------------------------------
REPO = "P20000/EnvScale"

def cmd_pm_status(args):
    print(f"\n{BOLD}{CYAN}=== EnvScale GitHub Task Issues ==={NC}\n")
    run_cmd(f"gh issue list --repo '{REPO}' --limit 50 --state open")

def cmd_pm_list(args):
    assignee = getattr(args, "assignee", None)
    if assignee:
        print(f"\n{BOLD}{CYAN}=== Open Issues assigned to {assignee} ==={NC}\n")
        run_cmd(f"gh issue list --repo '{REPO}' --assignee '{assignee}' --state open")
    else:
        print(f"\n{BOLD}{CYAN}=== All Open GitHub Issues ==={NC}\n")
        run_cmd(f"gh issue list --repo '{REPO}' --state open")

def cmd_pm_close(args):
    issue_no = args.issue_no
    print(f"{GREEN}Closing Issue #{issue_no}...{NC}")
    run_cmd(f"gh issue close '{issue_no}' --repo '{REPO}'")

# ------------------------------------------------------------------------------
# CLI Parser & Entry Point
# ------------------------------------------------------------------------------
def main():
    parser = argparse.ArgumentParser(description="EnvScale Unified AI Assistant & Developer CLI (agent)")
    subparsers = parser.add_subparsers(dest="command", help="Available commands")

    # check
    p_check = subparsers.add_parser("check", help="Run monorepo build, typecheck, and lint verification")
    p_check.add_argument("--json", action="store_true", help="Output machine-parseable JSON")

    # demo-check
    p_demo = subparsers.add_parser("demo-check", help="Run pre-defense smoke test across services & ports")
    p_demo.add_argument("--json", action="store_true", help="Output machine-parseable JSON")

    # summary
    p_sum = subparsers.add_parser("summary", help="Git & filesystem aware task summary across all milestones")
    p_sum.add_argument("--json", action="store_true", help="Output machine-parseable JSON")
    p_sum.add_argument("--human", action="store_true", help="Force human-readable colorized table output")

    # audit
    p_audit = subparsers.add_parser("audit", help="Deep structural audit for targeted task ID(s), assignee, or review tasks")
    p_audit.add_argument("task_ids", nargs="*", help="Task ID(s) (e.g. VIN-08 VIN-09 VIN-10)")
    p_audit.add_argument("--assignee", "-a", help="Filter by owner/assignee (Vinit, Pranav, Neha, Ishika)")
    p_audit.add_argument("--review", "-r", action="store_true", help="Audit review/pending milestone tasks")
    p_audit.add_argument("--json", action="store_true", help="Output machine-parseable JSON")

    # owner
    p_owner = subparsers.add_parser("owner", help="Ownership and load mapping per team member")
    p_owner.add_argument("--json", action="store_true", help="Output machine-parseable JSON")

    # env
    p_env = subparsers.add_parser("env", help="Check for .env configuration drift against templates")
    p_env.add_argument("--json", action="store_true", help="Output machine-parseable JSON")

    # blocked
    p_block = subparsers.add_parser("blocked", help="Surfaces tasks blocked by incomplete dependencies")
    p_block.add_argument("--json", action="store_true", help="Output machine-parseable JSON")

    # diff
    p_diff = subparsers.add_parser("diff", help="Diff branch changes against develop and map to task IDs")
    p_diff.add_argument("branch", nargs="?", default="HEAD", help="Branch name to diff")
    p_diff.add_argument("--json", action="store_true", help="Output machine-parseable JSON")

    # install-hooks
    p_hooks = subparsers.add_parser("install-hooks", help="Install git pre-push guardrail hooks blocking direct pushes to main")

    # Legacy / PM commands
    p_status = subparsers.add_parser("status", help="List open GitHub issues")
    p_list = subparsers.add_parser("list", help="List GitHub issues")
    p_list.add_argument("assignee", nargs="?", help="Filter by assignee")

    p_close = subparsers.add_parser("close", help="Close a GitHub issue")
    p_close.add_argument("issue_no", help="Issue number to close")

    args = parser.parse_args()

    # Automatically ensure pre-push hook is installed
    ensure_git_hooks()

    if not args.command:
        parser.print_help()
        sys.exit(0)

    dispatch = {
        "check": cmd_check,
        "demo-check": cmd_demo_check,
        "summary": cmd_summary,
        "audit": cmd_audit,
        "owner": cmd_owner,
        "env": cmd_env,
        "blocked": cmd_blocked,
        "diff": cmd_diff,
        "install-hooks": cmd_install_hooks,
        "status": cmd_pm_status,
        "list": cmd_pm_list,
        "close": cmd_pm_close,
    }

    if args.command in dispatch:
        dispatch[args.command](args)
    else:
        parser.print_help()

if __name__ == "__main__":
    main()
